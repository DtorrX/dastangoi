# Core
APP_ENV=local
APP_BASE_URL=http://localhost:8000
ADMIN_API_KEY=change-me

# Huginn
HUGINN_URL=http://huginn:3000
HUGINN_WEBHOOK_SECRET=change-me

# Database
POSTGRES_USER=huginn
POSTGRES_PASSWORD=huginn
POSTGRES_DB=huginn
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Reporter
REPORT_ARCHIVE_PATH=/data/archives
REPORT_TIMEZONE=America/Toronto
REPORT_CUTOFF_HOUR=6

# Mailer
MAILER_FROM=signals@example.com
MAILER_PROVIDER=ses
SES_REGION=us-east-1
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
UNSUBSCRIBE_SECRET=change-me

# Billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_PAID=price_paid
STRIPE_PRICE_PRO=price_pro

# LLM (BYO key)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
