{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyReport",
  "type": "object",
  "properties": {
    "date": {"type": "string"},
    "executive_summary": {"type": "array", "items": {"type": "string"}},
    "narratives": {"type": "array"},
    "notable_items": {"type": "array"},
    "network_signals": {"type": "array"},
    "recommendations": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["date", "executive_summary", "narratives", "notable_items"]
}
